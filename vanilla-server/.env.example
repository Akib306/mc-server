# Required for the ngrok container.
NGROK_AUTHTOKEN=replace-with-your-ngrok-token

# Minecraft server settings.
MC_SERVER_TYPE=PAPER
MC_VERSION=LATEST
MC_MEMORY=2G
MC_PORT=25565
MC_MOTD=Docker Minecraft Server
MC_DIFFICULTY=normal
MC_ONLINE_MODE=TRUE

# Used only when starting with scripts/start-forge.sh.
FORGE_VERSION=RECOMMENDED
